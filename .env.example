# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://ztn.example
SESSION_COOKIE_SECURE=true
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
MARKETPLACE_AUTOCOMPLETE_SECRET=

# Rate limiting (Upstash Redis free tier - optional, falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# Admin
ADMIN_EMAIL=muhdinnovel2@gmail.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Didit KYC
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_API_URL=https://verification.didit.me

# Backblaze B2 S3 API
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=ztn-market
B2_KEY_ID=
B2_APPLICATION_KEY=

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@ztn.example
BREVO_SENDER_NAME=ZTN
BREVO_REPLY_TO=
BREVO_WEBHOOK_SECRET=

 # Veritas server-side payment adapter
# https://veritas.et/docs
VERITAS_API_URL=https://verifyapi.leulzenebe.pro
VERITAS_API_KEY=
VERITAS_WEBHOOK_SECRET=
VERITAS_PAYOUT_ACCOUNT_ID=

# Waliya top-up supplier - https://waliyatopup.com/developer
WALIYA_PUBLIC_KEY=
WALIYA_SECRET_KEY=

# HL Gaming Free Fire UID check (optional - free plan, 750 checks/month)
HLGAMING_USER_UID=
HLGAMING_API_KEY=

# Manual payment instructions shown to customers
STORE_PAYMENT_TELEBIRR_NAME=ZTN Official
STORE_PAYMENT_TELEBIRR_NUMBER=
STORE_PAYMENT_CBE_NAME=ZTN Official
STORE_PAYMENT_CBE_ACCOUNT=

AUTO_COMPLETE_SECRET=